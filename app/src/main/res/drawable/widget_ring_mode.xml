<?xml version="1.0" encoding="utf-8"?>
<!-- @tag:new-ui mode ring of the widget: a RemoteViews ProgressBar cannot be tinted below API 31, so one drawable per colour -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:innerRadius="5dp" android:thickness="2dp" android:useLevel="false">
            <solid android:color="@color/widgetBarTrack" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270" android:toDegrees="270" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadius="5dp" android:thickness="2dp" android:useLevel="true">
                <solid android:color="@color/widgetRingMode" />
            </shape>
        </rotate>
    </item>
</layer-list>
