<!-- @tag:new-ui a limited category: its title, then a thin bar for the day limit and one for the week limit -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:background="@color/widgetGlass"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/widgetInnerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="5dp"
        android:paddingBottom="3dp"
        android:orientation="vertical">

        <TextView
            tools:text="Игры"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="12sp"
            android:textColor="@color/widgetGlassText" />

        <FrameLayout
            android:id="@+id/dayBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="3dp">

            <ProgressBar
                android:id="@+id/dayProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:minHeight="3dp"
                android:maxHeight="3dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_bar"
                tools:progress="40" />

            <FrameLayout
                android:id="@+id/dayOver"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@drawable/widget_bar_over"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/weekBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="2dp">

            <ProgressBar
                android:id="@+id/weekProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:minHeight="3dp"
                android:maxHeight="3dp"
                android:indeterminate="false"
                android:max="100"
                android:progressDrawable="@drawable/widget_bar"
                tools:progress="40" />

            <FrameLayout
                android:id="@+id/weekOver"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@drawable/widget_bar_over"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>
</FrameLayout>
